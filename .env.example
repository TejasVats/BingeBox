POSTGRES_DB=bingebox
POSTGRES_USER=bingebox
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SERVER_PORT=8080
BACKEND_BASE_URL=http://localhost:8080

# Use a randomly generated value (at least 32 characters) outside local development.
BINGEBOX_JWT_SECRET=replace-this-local-development-secret-before-deploying
# Create a Groq API key and keep it server-side only.
BINGEBOX_GROQ_API_KEY=replace-with-your-groq-api-key
# Optional overrides. The defaults are llama-3.1-8b-instant and llama-3.3-70b-versatile.
BINGEBOX_GROQ_BASE_URL=https://api.groq.com/openai/v1
BINGEBOX_GROQ_FAST_MODEL=llama-3.1-8b-instant
BINGEBOX_GROQ_ADVANCED_MODEL=llama-3.3-70b-versatile